# 1. Calculate annual averages across regions
annual_means <- df_clean %>%
group_by(Year) %>%
summarise(
Zt_Severity = mean(c(
L1_Zymoseptoria_tritici_Disease_Severity,
L2_Zymoseptoria_tritici_Disease_Severity
), na.rm = TRUE),
Yr_Severity = mean(c(
L1_Yellow_rust_Disease_Severity,
L2_Yellow_rust_Disease_Severity
), na.rm = TRUE),
Zt_Incidence = mean(c(
L1_Zymoseptoria_tritici_Crop_Incidence,
L2_Zymoseptoria_tritici_Crop_Incidence
), na.rm = TRUE),
Yr_Incidence = mean(c(
L1_Yellow_rust_Crop_Incidence,
L2_Yellow_rust_Crop_Incidence
), na.rm = TRUE),
.groups = "drop"
)
annual_means
# 2. Convert to long format
annual_long <- annual_means %>%
pivot_longer(
cols = -Year,
names_to = "Metric",
values_to = "Value"
) %>%
mutate(
Disease = case_when(
str_starts(Metric, "Zt") ~ "Zymoseptoria tritici",
str_starts(Metric, "Yr") ~ "Yellow rust"
),
Measure = case_when(
str_ends(Metric, "Severity") ~ "Disease severity",
str_ends(Metric, "Incidence") ~ "Crop incidence"
)
)
# 3. Plot Figure 2
fig2 <- ggplot(
annual_long,
aes(x = Year, y = Value, colour = Disease)
) +
geom_line(linewidth = 0.9) +
geom_point(size = 1.5) +
facet_wrap(
~ Measure,
scales = "free_y",
ncol = 1
) +
scale_colour_manual(
values = c(
"Zymoseptoria tritici" = "#7B3294",
"Yellow rust" = "#008837"
)
) +
labs(
title = "Temporal trends in wheat disease across the UK",
subtitle = "Annual mean disease severity and crop incidence",
x = "Year",
y = NULL,
colour = "Disease"
) +
theme_minimal(base_size = 12) +
theme(
plot.title = element_text(face = "bold"),
legend.position = "bottom",
strip.text = element_text(face = "bold"),
panel.grid.minor = element_blank()
)
fig2
ggsave(
"/Users/alexrabeau/Desktop/SPHERE/NHS-AD-forecasting/adas-fig2.png",
fig2,
width = 11,
height = 9,
dpi = 600,
bg = "white"
)
