# Calculate the time difference between consecutive observations
# for each variable
resolution_data <- nhs_data %>%
arrange(metric_name, dt) %>%
group_by(metric_name) %>%
mutate(
time_diff = as.numeric(difftime(dt, lag(dt), units = "mins"))
) %>%
summarise(
# Use the median interval to determine the typical resolution
resolution_mins = median(time_diff, na.rm = TRUE),
.groups = "drop"
)
View(resolution_data)
str(nhs_data)
# Figure 2#----
# Convert dt to POSIXct
nhs_data <- nhs_data %>%
mutate(dt = as.POSIXct(dt, format = "%Y-%m-%d %H:%M:%S", tz = "UTC"))
# Calculate the most common interval for each metric/site combination
resolution_data <- nhs_data %>%
arrange(metric_name, coverage, dt) %>%
group_by(metric_name, coverage) %>%
mutate(
time_diff = as.numeric(difftime(dt, lag(dt), units = "mins"))
) %>%
filter(!is.na(time_diff), time_diff > 0) %>%
count(time_diff, name = "n") %>%
slice_max(n, n = 1, with_ties = FALSE) %>%
ungroup() %>%
rename(resolution_mins = time_diff)
# Count the number of variables at each resolution
resolution_summary <- resolution_data %>%
mutate(
resolution = case_when(
resolution_mins < 60 ~ paste0(resolution_mins, " min"),
resolution_mins < 1440 ~ paste0(resolution_mins / 60, " hr"),
resolution_mins < 10080 ~ paste0(resolution_mins / 1440, " day"),
resolution_mins < 43200 ~ paste0(resolution_mins / 10080, " week"),
TRUE ~ paste0(round(resolution_mins / 43200, 1), " month")
)
) %>%
count(resolution_mins, resolution, name = "n_variables") %>%
arrange(resolution_mins)
resolution_summary
ggplot(resolution_summary,
aes(x = reorder(resolution, resolution_mins),
y = n_variables)) +
geom_col() +
geom_text(
aes(label = n_variables),
hjust = -0.1
) +
coord_flip() +
labs(
x = "Temporal resolution",
y = "Number of variables",
title = "Temporal Resolution Across NHS Dataset"
) +
theme_minimal() +
expand_limits(
y = max(resolution_summary$n_variables) * 1.1
)
# Convert dt to datetime
nhs_data <- nhs_data %>%
mutate(
dt = as.POSIXct(
dt,
format = "%Y-%m-%d %H:%M:%S",
tz = "UTC"
)
)
# Calculate the most common time interval for each metric
resolution_data <- nhs_data %>%
arrange(metric_name, dt) %>%
group_by(metric_name) %>%
mutate(
time_diff = as.numeric(
difftime(dt, lag(dt), units = "mins")
)
) %>%
filter(!is.na(time_diff), time_diff > 0) %>%
count(time_diff, name = "n") %>%
slice_max(n, n = 1, with_ties = FALSE) %>%
ungroup() %>%
rename(resolution_mins = time_diff)
# Check number of variables
nrow(resolution_data)
# Check unique variables in original data
nhs_data %>%
summarise(n_variables = n_distinct(metric_name))
resolution_summary <- resolution_data %>%
mutate(
resolution = case_when(
resolution_mins < 60 ~ paste0(resolution_mins, " min"),
resolution_mins < 1440 ~ paste0(resolution_mins / 60, " hr"),
resolution_mins < 10080 ~ paste0(resolution_mins / 1440, " day"),
resolution_mins < 43200 ~ paste0(resolution_mins / 10080, " week"),
TRUE ~ paste0(round(resolution_mins / 43200, 1), " month")
)
) %>%
count(resolution_mins, resolution, name = "n_variables") %>%
arrange(resolution_mins)
resolution_summary
